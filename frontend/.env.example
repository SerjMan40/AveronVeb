# Optional public contact address shown in the footer after it is confirmed.
# VITE_PUBLIC_CONTACT_EMAIL=studio@example.com
# Public phone shown in the desktop header and footer. Use international format.
# VITE_PUBLIC_CONTACT_PHONE=+380 98 125 62 84
# Optional verified studio profiles and direct messaging links for the footer.
# VITE_PUBLIC_FACEBOOK_URL=
# VITE_PUBLIC_TELEGRAM_URL=
# VITE_PUBLIC_INSTAGRAM_URL=
# VITE_PUBLIC_LINKEDIN_URL=
# Production HTTPS origin for canonical URLs, hreflang and the sitemap.
# AVERON_SITE_URL=https://your-confirmed-domain.example

# Public API URL for a separately hosted backend, including /api.
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
